# Minimal build context + boundary defence: local private files never reach the image.
# ASCII only - the SAM CLI reads this file with the system codepage, not UTF-8.

# Holdings and secrets (kept out of the build context even though the Dockerfile
# does not COPY them).
*.local.yaml
*.env
.env
.aws-bucket-name.local

# Data and models (GB scale; the cloud tier rebuilds its own).
data/
models/
runs/
logs/
reports/
exports/

# Delivery surface and dev-only trees.
.git/
.github/
docs/
powerbi/
notebooks/
tests/
venv311/
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# dbt local artifacts (regenerated inside the container).
warehouse/target/
warehouse/logs/
warehouse/dbt_packages/

# IaC local state.
.aws-sam/
samconfig.toml
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
